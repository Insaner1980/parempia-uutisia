# Copy to .env.local. Never commit real credentials.
SITE_URL=http://localhost:3000
DATABASE_PATH=data/news.sqlite
DEMO_MODE=false
# Explicit permission to preview demo data with a production build locally.
ALLOW_DEMO_PREVIEW=false

AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# At least 32 random characters. Required for administration.
ADMIN_SECRET=
CONTACT_EMAIL=

INGEST_MAX_AGE_DAYS=30
INGEST_MAX_ITEMS_PER_SOURCE=20
MIN_POSITIVE_CENTRALITY=0.80
MIN_FACTUAL_CONFIDENCE=0.90
MIN_SOURCE_SUFFICIENCY=0.85
